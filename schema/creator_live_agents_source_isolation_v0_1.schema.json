    "repository_read_count": {"type": "integer", "minimum": 0},
    "current_after_access_count": {"type": "integer", "minimum": 0},
    "git_access_count": {"type": "integer", "minimum": 0},
    "prohibited_capability_event_count": {"type": "integer", "minimum": 0},
    "dynamic_tool_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "isolation_features_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "event_log_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "normal_terminal": {"type": "boolean"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "reason_codes": {"maxItems": 0},
          "source_identity_sha256": {"const": "7441621b31857a01eb547d1e1923e90a03141503bd3623b5af8ae27e2e6f820f"},
          "source_call_count": {"const": 1},
          "successful_semantic_disclosure_count": {"const": 1},
          "distinct_exposed_source_count": {"const": 1},
          "repository_read_count": {"const": 0},
          "current_after_access_count": {"const": 0},
          "git_access_count": {"const": 0},
          "prohibited_capability_event_count": {"const": 0},
          "dynamic_tool_manifest_sha256": {"const": "9831435392020246929fed803614e8a9e6f77ee7f9d4d903ec2ddd8ab2b4de6f"},
          "isolation_features_sha256": {"const": "01034fca6f557b1c938543118c625209ca15478f5a5435a78f897a8ae400b650"},
          "event_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "normal_terminal": {"const": true}
        }
