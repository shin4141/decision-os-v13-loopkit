{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-os.creator-live-agents-source-isolation.v0.1",
  "title": "Creator-Live AGENTS Source Isolation Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "result", "reason_codes", "source_identity", "source_identity_sha256", "source_call_count", "successful_semantic_disclosure_count", "distinct_exposed_source_count", "repository_read_count", "current_after_access_count", "git_access_count", "prohibited_capability_event_count", "dynamic_tool_manifest_sha256", "isolation_features_sha256", "event_log_sha256", "normal_terminal", "receipt_sha256"],
